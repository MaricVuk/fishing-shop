# Development values only. Copy to .env to override; never commit real secrets.
# docker compose reads .env automatically. Spring Boot falls back to the same
# defaults in application.yml, so the app also runs without a .env file.

# Postgres container (docker-compose.yml)
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_dev_password

# Backend datasource (application.yml)
DB_URL=jdbc:postgresql://localhost:5432/shop
DB_USER=shop
DB_PASSWORD=shop_dev_password
