# Development values only; never commit real secrets.
# Only docker compose reads this file. The backend reads real environment
# variables (or the dev profile defaults) and the frontend reads frontend/.env.local.

# Postgres container (docker-compose.yml)
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_dev_password

# Backend datasource (required without the dev profile)
DB_URL=jdbc:postgresql://localhost:5432/shop
DB_USER=shop
DB_PASSWORD=shop_dev_password

# First owner account, created only while there are no employees (at least 12 characters).
# Not needed with the dev profile, which seeds one account per role.
SHOP_OWNER_EMAIL=
SHOP_OWNER_PASSWORD=
SHOP_OWNER_NAME=

# Outgoing email (required without the dev profile, which sends to Mailpit on localhost:1025).
# SHOP_MAIL_FROM accepts a display name: Ribolovacki shop <prodaja@example.com>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SHOP_MAIL_FROM=

# Seller shown on PDF invoices (required without the dev profile, which uses demo values).
SHOP_SELLER_NAME=
SHOP_SELLER_ADDRESS=
SHOP_SELLER_TAX_ID=
SHOP_SELLER_REGISTRATION_NUMBER=
SHOP_SELLER_BANK_ACCOUNT=
